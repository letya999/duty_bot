# ============================================
# Duty Bot - PRODUCTION Configuration Template
# ============================================
# Copy this file to .env and fill in your production values

# === TELEGRAM BOT ===
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=123456789

# === SLACK BOT ===
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your_signing_secret
SLACK_CHANNEL_ID=C123456789

# === SLACK OAUTH (for web admin panel) ===
SLACK_CLIENT_ID=123456789.1234567890123
SLACK_CLIENT_SECRET=your-client-secret-here
SLACK_REDIRECT_URI=https://yourdomain.com/api/admin/auth/slack/callback

# === DATABASE ===
# Use production PostgreSQL database
DATABASE_URL=postgresql+asyncpg://user:password@postgres-host:5432/duty_bot

# === APPLICATION SETTINGS ===
TIMEZONE=UTC
MORNING_DIGEST_TIME=09:00
REMINDER_BEFORE_MINUTES=30
ESCALATION_TIMEOUT_MINUTES=15
LOG_LEVEL=INFO

# === ADMIN CONFIGURATION ===
ADMIN_TELEGRAM_IDS=123456789,987654321
ADMIN_SLACK_IDS=U12345678,U87654321

# === SERVER ===
HOST=0.0.0.0
PORT=8000

# === WEBAPP (Frontend) ===
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# IMPORTANT: Use HTTPS in production!
VITE_API_URL=https://yourdomain.com/api/admin
VITE_API_BACKEND=https://yourdomain.com

VITE_APP_HOST=yourdomain.com

# === CORS (CRITICAL FOR PRODUCTION) ===
# List all domains that should be allowed to access the API
# Include both www and non-www versions if needed
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# === DATABASE DOCKER ===
POSTGRES_DB=duty_bot
POSTGRES_USER=user
POSTGRES_PASSWORD=secure_password_here
