# ============================================
# Duty Bot Configuration
# ============================================

# === TELEGRAM BOT ===
# Your Telegram bot token (get from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token

# Telegram chat ID for sending messages (find with @userinfobot)
TELEGRAM_CHAT_ID=

# === SLACK BOT ===
# Slack bot token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack signing secret for webhook verification
SLACK_SIGNING_SECRET=your_signing_secret

# Slack channel ID for posting messages
SLACK_CHANNEL_ID=

# === SLACK OAUTH (for web admin panel) ===
# Get from Slack App Settings → Basic Information
SLACK_CLIENT_ID=123456789.1234567890123
SLACK_CLIENT_SECRET=your-client-secret-here

# Redirect URI for OAuth callback
# For local dev: http://localhost:8000/api/admin/auth/slack/callback
# For production: https://yourdomain.com/api/admin/auth/slack/callback
SLACK_REDIRECT_URI=http://localhost:8000/api/admin/auth/slack/callback

# === DATABASE ===
# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=duty_bot
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=duty_bot

# PostgreSQL connection string
# For Docker: postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# For local: postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
DATABASE_URL=postgresql+asyncpg://duty_bot:your_secure_password_here@localhost:5432/duty_bot

# Database credentials for Docker Compose
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=duty_bot

# === APPLICATION SETTINGS ===
# Timezone for scheduled tasks
TIMEZONE=UTC

# Time to send morning digest (HH:MM format, 24h)
MORNING_DIGEST_TIME=09:00

# Minutes before duty to send reminder
REMINDER_BEFORE_MINUTES=30

# Minutes before escalation timeout
ESCALATION_TIMEOUT_MINUTES=15

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# === ADMIN CONFIGURATION ===
# Comma-separated Telegram user IDs with admin permissions
# If not set, all users can perform admin actions
# Find IDs with @userinfobot
ADMIN_TELEGRAM_IDS=

# Comma-separated Slack user IDs with admin permissions
# If not set, all users can perform admin actions
# Format: U123456789,U987654321
ADMIN_SLACK_IDS=

# === SERVER ===
# Server host (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Server port
PORT=8000

# === WEBAPP (Frontend) ===
# Bot username for Telegram Login Widget (without @)
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# API base URL for webapp
# For local dev: /api/admin (relative) or http://localhost:8000/api/admin
# For production: https://yourdomain.com/api/admin
VITE_API_URL=/api/admin

# Backend API URL for Vite dev server proxy
# Points to where the API endpoints are located
# In Docker: http://app:8000 (service name in docker-compose)
# Locally: http://localhost:8000
VITE_API_BACKEND=http://app:8000

# Allowed hostname for Vite dev server
# For production: yourdomain.com
# Leave empty for localhost only (default)
VITE_APP_HOST=localhost

# === SECURITY & ENCRYPTION ===
# Key for encrypting sensitive data (Google Calendar credentials, etc)
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=generate_with_python_command

# General-purpose secret for application security
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(48)).decode())"
SECRET_KEY=generate_with_python_command

# Secret for signing session cookies
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
SESSION_SECRET=generate_with_python_command

# API token for internal API access
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
API_TOKEN=generate_with_python_command

# === ENVIRONMENT ===
# development, staging, or production
ENVIRONMENT=development

# === CORS (IMPORTANT FOR PRODUCTION) ===
# Comma-separated list of allowed origins for CORS
# For development: leave empty (defaults to localhost:5173, localhost:3000, localhost:8000)
# For production: MUST be set to your specific domains
# Example for production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=

